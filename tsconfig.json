{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@components/handler": ["./src/exports/components/handler"],
      "@components/layout": ["./src/exports/components/layout"],
      "@components/page": ["./src/exports/components/page"],
      "@components/ui": ["./src/exports/components/ui"],
      "@fonts/static": ["./src/exports/fonts/static"],
      "@fonts/variable": ["./src/exports/fonts/variable"],
      "@library/contexts": ["./src/exports/library/contexts"],
      "@library/handlers": ["./src/exports/library/handlers"],
      "@library/hooks": ["./src/exports/library/hooks"],
      "@library/policies": ["./src/exports/library/policies"],
      "@library/providers": ["./src/exports/library/providers"],
      "@library/utilities": ["./src/exports/library/utilities"],
      "@styles/handler": ["./src/exports/styles/handler"],
      "@styles/layout": ["./src/exports/styles/layout"],
      "@styles/page": ["./src/exports/styles/page"],
      "@styles/ui": ["./src/exports/styles/ui"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2017"
  },
  "exclude": ["node_modules"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ]
}
